      value: rocher 2 (7)
      objectReference: {fileID: 0}
    - target: {fileID: 1766948120809269905, guid: 13b31a9c1283a7f4f8a026da588c730d, type: 3}
      propertyPath: m_text
      value: "Dans la peau d\u2019un pillard avide de richesses, nous explorons le
        myst\xE9rieux Sanctuaire d\u2019Ouranos sur une \xEEle recul\xE9e. En s\u2019emparant
        d\u2019un puissant artefact, l\u2019\u0152il du Ciel, nous d\xE9clenchons
        la col\xE8re divine : une temp\xEAte s\u2019abat, l\u2019\xEEle se transforme
        en un lieu hostile, et notre corps subit une \xE9trange m\xE9tamorphose.
        Dot\xE9s de nouvelles capacit\xE9s, nous devons maintenant affronter les
        dangers de l\u2019\xEEle maudite pour atteindre le temple et r\xE9parer notre
        sacril\xE8ge."
      objectReference: {fileID: 0}
    - target: {fileID: 5506217462129133637, guid: 13b31a9c1283a7f4f8a026da588c730d, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
